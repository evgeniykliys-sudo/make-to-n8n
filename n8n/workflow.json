{
  "id": "mkMigratedLead01",
  "name": "Заявка → Telegram (перенесён из Make)",
  "active": false,
  "settings": {"executionOrder": "v1"},
  "nodes": [
    {
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "5d3c1a7e-0001-4000-8000-0000000a11ad",
      "parameters": {"httpMethod": "POST", "path": "lead-migrated", "responseMode": "responseNode", "options": {}}
    },
    {
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Есть телефон?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0],
      "notes": "Make: фильтр «{{1.phone}} exist». В Make пустая строка = НЕ существует, поэтому здесь notEmpty, а не exists.",
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2},
          "conditions": [
            {"id": "c1", "leftValue": "={{ $json.body.phone }}", "rightValue": "",
             "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}}
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Текст заявки",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, -120],
      "notes": "Make: trim() → (x ?? '').trim(); replace(x; \"/re/g\"; emptystring) → String(x).replace(/re/g, ''); ifempty(x; \"y\") → x || 'y' (НЕ ??: ifempty считает пустую строку пустой).",
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {"id": "t1", "name": "text", "type": "string",
             "value": "={{ '🆕 Новая заявка\\nИмя: ' + String($json.body.name ?? '').trim() + '\\nТелефон: ' + String($json.body.phone).replace(/[^0-9+]/g, '') + '\\nСообщение: ' + ($json.body.message || '—') + '\\nИсточник: ' + ($json.body.source || 'сайт') }}"}
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, -120],
      "notes": "Make: HTTP GET api.telegram.org/.../sendMessage. appendAttribution=false — иначе n8n допишет к сообщению свою подпись и текст разойдётся с Make.",
      "parameters": {
        "chatId": "436026215",
        "text": "={{ $json.text }}",
        "additionalFields": {"appendAttribution": false}
      },
      "credentials": {"telegramApi": {"id": "L3DcKr9ATWIDkvPB", "name": "Telegram - currency-bot"}}
    },
    {
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Ответ 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, -120],
      "notes": "После узла Telegram в $json — ответ Telegram, поэтому текст берём из узла «Текст заявки».",
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $('Текст заявки').item.json.text }}",
        "options": {"responseCode": 200}
      }
    },
    {
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Ответ 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 120],
      "parameters": {
        "respondWith": "text",
        "responseBody": "Заявка без телефона — не отправлена",
        "options": {"responseCode": 422}
      }
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Есть телефон?", "type": "main", "index": 0}]]},
    "Есть телефон?": {"main": [
      [{"node": "Текст заявки", "type": "main", "index": 0}],
      [{"node": "Ответ 422", "type": "main", "index": 0}]
    ]},
    "Текст заявки": {"main": [[{"node": "Telegram", "type": "main", "index": 0}]]},
    "Telegram": {"main": [[{"node": "Ответ 200", "type": "main", "index": 0}]]}
  }
}
